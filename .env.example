DJANGO_SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# PredictMyGrade-Demo is intentionally mock-only.
# Checkout stays local, no real payment provider is contacted, and the assistant
# uses deterministic local demo responses while this is enabled.
BILLING_MOCK_MODE=1

# Demo data / browser-review defaults
ONBOARDING_SAMPLE_DATA_ENABLED=true
AI_CHAT_DAILY_LIMIT=20

# Do not add payment, OAuth, SMTP, or AI-provider secrets to the portfolio demo.
